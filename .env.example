# =====================================================================
# BeyondIP Enterprise IPAM — Environment Configuration
# =====================================================================

# 1. MySQL Database Connection Configuration
# Specify individual parameters OR provide a unified MYSQL_URL (or DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ipam_user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DATABASE=ipam_db
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10

# Docker Compose only: root password for the bundled MySQL container
MYSQL_ROOT_PASSWORD=your_secure_root_password

# Optional unified connection string:
# MYSQL_URL=mysql://ipam_user:your_secure_mysql_password@localhost:3306/ipam_db

# Password for admin@beyondip.internal, used only when the database is first seeded
IPAM_ADMIN_PASSWORD=

# Session cookie is HTTPS-only in production. Set to false only if browsers use plain http://
COOKIE_SECURE=true

# 3. Application URL (injected automatically in cloud environments)
APP_URL=http://localhost:3000
