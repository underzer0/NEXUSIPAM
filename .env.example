# =====================================================================
# BeyondIP Enterprise IPAM — Environment Configuration
# =====================================================================

# 1. MySQL Database Connection Configuration
# Specify individual parameters OR provide a unified MYSQL_URL (or DATABASE_URL)
MYSQL_HOST=localhost
MYSQL_PORT=3306
MYSQL_USER=ipam_user
MYSQL_PASSWORD=your_secure_mysql_password
MYSQL_DATABASE=ipam_db
MYSQL_SSL=false
MYSQL_CONNECTION_LIMIT=10

# Optional unified connection string:
# MYSQL_URL=mysql://ipam_user:your_secure_mysql_password@localhost:3306/ipam_db

# 2. Cryptographic Encryption & Token Secrets
# Master key used to symmetrically encrypt sensitive tokens and API keys (min 32 chars)
APP_SECRET_KEY=change_this_to_a_cryptographically_secure_random_32_char_key

# 3. Gemini AI Configuration (if used for intelligent subnet suggestions)
GEMINI_API_KEY=

# 4. Application URL (injected automatically in cloud environments)
APP_URL=http://localhost:3000
